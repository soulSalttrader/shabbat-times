root = true

# To disable a ktlint rule, use: ktlint_<ruleset-id>_<rule-id> = disabled
# The ruleset/rule-id come from the violation message ktlint prints, e.g.:
#   "... (standard:function-signature)" → ktlint_standard_function-signature = disabled
# See docs/CODE_STYLE_EXCEPTIONS.md for why each rule below is disabled.

# ========== All files ==========
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ========== Kotlin files ==========
# noinspection EditorConfigKeyCorrectness
[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 120
ktlint_code_style = android_studio
ktlint_standard_blank-line-before-declaration = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_blank-line-between-when-conditions = disabled

# --- Signatures ---
# Allow 2 parameters on one line, force multiline from 3+
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 3
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 3
ktlint_standard_class-signature = disabled
ktlint_standard_function-signature = disabled

# Function body expressions
ktlint_function_signature_body_expression_wrapping = multiline

# --- Trailing commas ---
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# --- Imports ---
# Standard Android/Kotlin import order
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, kotlinx.**, ^
# Allow common wildcard imports used in Android
ij_kotlin_packages_to_use_import_on_demand = java.util.*
ktlint_standard_no-wildcard-imports = disabled

# --- Naming ---
# Ignore naming rule for @Composable functions instead of disabling it entirely
ktlint_function_naming_ignore_when_annotated_with = Composable

# Property naming: Ignore PascalCase for Composable properties
# Note: ktlint 1.0+ might require inline @Suppress for properties as it doesn't support annotation ignore for them yet.
ktlint_standard_property-naming = disabled

# --- Annotations ---
# Allow @Inject on the same line (common for Dagger/Hilt)
ktlint_standard_annotation = disabled
ktlint_standard_spacing-between-declarations-with-annotations = disabled

# --- Common noisy rules ---
ktlint_standard_filename = disabled
# ktlint_standard_argument-list-wrapping = disabled

# ========== Test files ==========
# noinspection EditorConfigKeyCorrectness
[**/*Test.kt]
# Allow backticked names for tests
ktlint_standard_function-naming = disabled
